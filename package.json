{
  "name": "touchlab",
  "private": true,
  "version": "1.0.0",
  "description": "TouchLab: realtime interactive visuals in the browser that you play with your hands, recorded to MP4",
  "author": "Mario Schebly",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "setup-assets": "node scripts/setup-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icon": "python scripts/make_icon.py",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File \"Create Desktop Shortcut.ps1\"",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
